# Base URL used for absolute links / Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: point the app at a real NFT API instead of the built-in mock
# Route Handlers (see README → "Why a mock API"). Must return the same
# shape as GET /api/products and GET /api/products/[id].
# NEXT_PUBLIC_API_BASE_URL=https://your-api.example.com/v1
