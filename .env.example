# Base URL used for absolute links / Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: override the products API base URL (see README → "Data
# fetching"). Defaults to the live Starsoft/MKS challenge API at
# https://api-challenge.starsoft.games/api/v1 — only set this to point at a
# different deployment (e.g. a local one implementing the same
# GET /products?page&rows&sortBy&orderBy contract).
# NEXT_PUBLIC_API_BASE_URL=https://your-api.example.com/v1
